{
  "realm": "recallpharma",
  "enabled": true,
  "displayName": "RecallPharma (développement)",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr",
    "en"
  ],
  "defaultLocale": "fr",
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 28800,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "passwordPolicy": "length(12)",
  "roles": {
    "realm": [
      {
        "name": "visiteur",
        "description": "Visiteur"
      },
      {
        "name": "inscrit",
        "description": "Inscrit"
      },
      {
        "name": "professionnel-verifie",
        "description": "Professionnel vérifié"
      },
      {
        "name": "titulaire",
        "description": "Titulaire"
      },
      {
        "name": "agent-autorite",
        "description": "Agent d'autorité"
      },
      {
        "name": "validateur",
        "description": "Validateur"
      },
      {
        "name": "responsable-reglementaire",
        "description": "Responsable réglementaire"
      },
      {
        "name": "responsable-produit",
        "description": "Responsable produit"
      },
      {
        "name": "evaluateur-pharmacovigilance",
        "description": "Évaluateur de pharmacovigilance"
      },
      {
        "name": "administrateur-fonctionnel",
        "description": "Administrateur fonctionnel"
      },
      {
        "name": "administrateur-technique",
        "description": "Administrateur technique"
      },
      {
        "name": "auditeur",
        "description": "Auditeur"
      },
      {
        "name": "application-partenaire",
        "description": "Application partenaire"
      }
    ]
  },
  "clients": [
    {
      "clientId": "recallpharma-api",
      "name": "API RecallPharma (audience des jetons)",
      "enabled": true,
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "recallpharma-web",
      "name": "Interface web RecallPharma (BFF)",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-web-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:3100/api/auth/callback",
        "http://localhost:3000/api/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3100",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3100/*##http://localhost:3000/*"
      },
      "defaultClientScopes": [
        "roles",
        "profile",
        "email",
        "basic",
        "web-origins",
        "acr"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience recallpharma-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "recallpharma-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
